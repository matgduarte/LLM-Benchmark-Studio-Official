# ──────────────────────────────────────────────────────────────
# LLM Benchmark Studio — Variáveis de ambiente
# Copie este arquivo para `.env` e ajuste conforme necessário.
# ──────────────────────────────────────────────────────────────

# ─── Obrigatório para execuções reais ────────────────────────────
# Chave da API do OpenRouter (sobrescreve a configurada via UI).
# Obtenha em: https://openrouter.ai/keys
# Exemplo: sk-or-v1-abcdef0123456789...
#
# Se omitida, configure a chave pela aba "Configurações" do app
# (ela será salva em data/config/settings.json).
OPENROUTER_API_KEY=

# ─── Opcional: chaves da tela "Uso & Custos" ─────────────────────
# Usadas APENAS para ler consumo naquela tela. Nenhuma execução de benchmark
# passa por elas. Ambas podem ser configuradas pela aba "Configurações".

# Management key do OpenRouter. Necessária para o consumo por dia/modelo:
# GET /api/v1/activity rejeita a chave de inferência com 403. Sem ela, só o
# saldo da conta aparece.
# Obtenha em: https://openrouter.ai/settings/management-keys
OPENROUTER_MANAGEMENT_KEY=

# Chave da OpenAI, para a Usage API da organização.
# Precisa do escopo de leitura da organização (api.usage.read).
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Opcional ────────────────────────────────────────────────────
# Diretório onde os dados (lotes, execuções, métricas) são persistidos.
# Padrão: <raiz-do-projeto>/data
# LLM_BENCH_DATA_DIR=

# ─── Não relacionado a este app (scaffold original) ──────────────
# Usado pelo Prisma (não usado pelo LLM Benchmark Studio).
# DATABASE_URL=file:./db/custom.db
